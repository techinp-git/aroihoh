// AroiHoh — Prisma schema
// โมเดล tenant: Merchant → Brand → Kitchen (ดู docs/adr/0005-tenant-schema.md)
// กติกาเหล็ก:
//   - business data ทุกตารางติด brandId (tenant key) · ตารางระดับเจ้าของติด merchantId
//   - เงินเป็น Int หน่วยสตางค์เสมอ (ห้าม float)
//   - เขตจัดส่ง/ค่าส่งผูกที่ Kitchen · เก็บทั้ง lat/lng+radius และ geometry (รองรับ ADR-02 ทั้งสองทาง)
// ขอบเขต schema นี้ = พอสำหรับ Sprint 1 MVP (EP-01 + US-07/08/09/11/12/14/15)
//   ยังไม่ใส่: coupon(US-17), broadcast(US-18), subscription/catering, loyalty — เพิ่มเป็น migration ทีหลัง

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ─────────────────────────── Tenant hierarchy ───────────────────────────

enum MerchantStatus {
  active
  suspended
}

model Merchant {
  id        String         @id @default(uuid())
  name      String
  slug      String         @unique
  status    MerchantStatus @default(active)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  brands     Brand[]
  kitchens   Kitchen[]
  adminUsers AdminUser[]

  @@map("merchants")
}

model Brand {
  id         String  @id @default(uuid())
  merchantId String
  name       String
  slug       String
  logoUrl    String?
  theme      Json?
  isActive   Boolean @default(true)
  codEnabled Boolean @default(true) // US-07: เปิด/ปิดรับเก็บเงินปลายทาง

  // US-19: ค่าใช้จ่ายคงที่ต่อวัน (สตางค์) — ค่าเช่า/คน/การตลาด เฉลี่ยต่อวัน ใช้หาจุดคุ้มทุน
  fixedCostDaily Int?

  /// US-55: สแกน QR สะสมแต้มได้กี่ใบต่อวันต่อลูกค้า 1 คน (null = ใช้ค่าเริ่มต้นในโค้ด)
  loyaltyDailyEarnCap Int?

  /// US-56: ทุกกี่บาทได้ 1 แต้ม เมื่อออเดอร์ส่งสำเร็จ (null = ปิด ไม่ให้แต้มอัตโนมัติ)
  loyaltyBahtPerPoint Int?

  // LINE credentials (SETUP-1) — secret/token ต้องเข้ารหัสก่อนเก็บ (US-25 cross-tenant isolation)
  lineChannelId        String? // Messaging API channel — ส่ง/รับข้อความ
  lineChannelSecretEnc String?
  lineChannelTokenEnc  String?
  // LINE Login channel — เจ้าของ LIFF app + ผู้ออก ID token (คนละเลขกับ Messaging channel)
  // ไม่กรอก = เดาจากเลขหน้า liffId (ดู auth/login-channel.ts)
  lineLoginChannelId   String?
  liffId               String?
  richMenuId           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant      Merchant       @relation(fields: [merchantId], references: [id])
  brandKitchens BrandKitchen[]
  categories    MenuCategory[]
  menuItems     MenuItem[]
  customers     Customer[]
  addresses     Address[]
  loyaltyBatches      LoyaltyQrBatch[]
  loyaltyCodes        LoyaltyQrCode[]
  loyaltyRewards      LoyaltyReward[]
  loyaltyRedemptions  LoyaltyRedemption[]
  loyaltyLedger       LoyaltyTransaction[]
  orders        Order[]
  payments      Payment[]
  messageLogs   MessageLog[]
  adminBrands   AdminBrand[]
  auditLogs     AuditLog[]
  chatMessages  ChatMessage[]
  broadcasts    Broadcast[]
  contents      ContentLibrary[]
  audiences     Audience[]
  richMenus     RichMenu[]

  @@unique([merchantId, slug])
  @@index([merchantId])
  @@map("brands")
}

enum ZoneType {
  radius
  polygon
}

model Kitchen {
  id            String                                  @id @default(uuid())
  merchantId    String
  name          String
  lat           Float
  lng           Float
  zoneType      ZoneType                                @default(radius)
  maxDistanceKm Float? // ใช้เมื่อ zoneType = radius (กลยุทธ์ Haversine)
  // ใช้เมื่อ zoneType = polygon (กลยุทธ์ PostGIS) — query ผ่าน raw SQL (ST_Contains)
  deliveryZone  Unsupported("geometry(Polygon, 4326)")?
  isOpen        Boolean                                 @default(true) // US-16: ปุ่มพักรับออเดอร์ฉุกเฉิน
  openTime      String? // US-16: เวลาเปิด "HH:MM" (null = เปิดตลอด)
  closeTime     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant      Merchant          @relation(fields: [merchantId], references: [id])
  brandKitchens BrandKitchen[]
  feeRules      DeliveryFeeRule[]
  orders        Order[]

  @@index([merchantId])
  @@map("kitchens")
}

// ครัวเดียวแชร์หลายแบรนด์ได้ (คอนเซปต์ "หลายแบรนด์ ครัวเดียว")
model BrandKitchen {
  brandId   String
  kitchenId String

  brand   Brand   @relation(fields: [brandId], references: [id])
  kitchen Kitchen @relation(fields: [kitchenId], references: [id])

  @@id([brandId, kitchenId])
  @@index([kitchenId])
  @@map("brand_kitchens")
}

enum FeeRuleType {
  flat
  tiered
  per_km
}

// US-15: กฎค่าส่ง flat/tiered/per_km — พารามิเตอร์เก็บใน params (เช่น tiers, perKm, baseFee)
model DeliveryFeeRule {
  id        String      @id @default(uuid())
  kitchenId String
  type      FeeRuleType
  params    Json
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  kitchen Kitchen @relation(fields: [kitchenId], references: [id])

  @@index([kitchenId])
  @@map("delivery_fee_rules")
}

// ─────────────────────────── Customers (PII — PDPA) ───────────────────────────

model Customer {
  id          String   @id @default(uuid())
  brandId     String
  lineUserId  String
  displayName String?
  pictureUrl  String?
  phoneEnc    String? // เข้ารหัส — ห้าม log
  tags        String[] @default([]) // US-21: แท็กลูกค้า (VIP, ประจำ, ฯลฯ)
  /// PDPA: ลูกค้ากดปฏิเสธข่าวสาร — ต้องเคารพเสมอ ไม่ว่าจะเคยยินยอมมาก่อนหรือไม่
  marketingOptedOut Boolean @default(false)
  /// PDPA ม.19: ยินยอมรับข่าวสารเมื่อไร (null = ยังไม่เคยยินยอม → ส่งการตลาดไม่ได้)
  marketingConsentAt     DateTime?
  /// มาจากไหน: 'legacy' (ยกมาจากระบบ opt-out เดิม) | 'liff' (ลูกค้ากดเอง) | 'admin'
  marketingConsentSource String?
  /// รับทราบนโยบายความเป็นส่วนตัวฉบับไหน เมื่อไร (คนละเรื่องกับความยินยอมการตลาด)
  policyAcceptedVersion  String?
  policyAcceptedAt       DateTime?
  /// US-50: cache ของ SUM(loyalty_transactions.points) — อัปเดตใน transaction เดียวกับ ledger เสมอ ห้ามติดลบ
  pointsBalance     Int     @default(0)
  /// Rich Menu ตามกลุ่ม: lineRichMenuId ที่ผูกให้ล่าสุด (null = อยู่ default) — ให้ sync diff ได้
  assignedRichMenuId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand           Brand                @relation(fields: [brandId], references: [id])
  addresses       Address[]
  orders          Order[]
  chatMessages    ChatMessage[]
  loyaltyCodes    LoyaltyQrCode[]
  redemptions     LoyaltyRedemption[]
  loyaltyLedger   LoyaltyTransaction[]

  @@unique([brandId, lineUserId])
  @@index([brandId])
  @@index([brandId, marketingConsentSource])
  @@map("customers")
}

// US-21 Chat Center: แชตแอดมิน↔ลูกค้า (inbound มาจาก LINE webhook, outbound ยิงกลับผ่าน LINE)
enum ChatDirection {
  inbound
  outbound
}

model ChatMessage {
  id         String        @id @default(uuid())
  brandId    String
  customerId String
  direction  ChatDirection
  text       String
  imagePath  String? // ชื่อไฟล์รูปใน MEDIA_DIR (เฉพาะข้อความรูปจากลูกค้า) — null = ข้อความปกติ
  adminId    String? // ผู้ส่ง (เฉพาะ outbound)
  isRead     Boolean       @default(false) // inbound ที่แอดมินยังไม่อ่าน
  createdAt  DateTime      @default(now())

  brand    Brand    @relation(fields: [brandId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([brandId, customerId, createdAt])
  @@map("chat_messages")
}

/// US-58: ตารางเดียว 2 บทบาท แยกด้วย isSaved
///  - isSaved=false → snapshot ที่อยู่ของออเดอร์ (ออเดอร์ชี้แถวนี้เสมอ)
///  - isSaved=true  → หมุดในสมุดที่อยู่ของลูกค้า (สูงสุด 5, default ได้ 1 — บังคับใน profile.service)
/// แก้/ลบหมุดในสมุดจึงไม่กระทบออเดอร์เก่า เพราะคนละแถวกัน
model Address {
  id         String    @id @default(uuid())
  brandId    String // tenant key (กติกาเหล็ก #1) — ที่อยู่ไม่แชร์ข้ามแบรนด์
  customerId String
  label      String? // "บ้าน" | "ที่ทำงาน" | ตั้งเอง
  detail     String
  note       String? // ชั้น/ห้อง/จุดสังเกต — ให้ไรเดอร์อ่าน
  lat        Float
  lng        Float
  isSaved    Boolean   @default(false)
  isDefault  Boolean   @default(false)
  deletedAt  DateTime? // soft delete — ออเดอร์เก่ายังชี้ได้
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  brand    Brand    @relation(fields: [brandId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  orders   Order[]

  @@index([customerId, isSaved])
  @@index([brandId])
  @@map("addresses")
}

// ─────────────────────────── Menu (US-14) ───────────────────────────

model MenuCategory {
  id        String  @id @default(uuid())
  brandId   String
  name      String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  brand Brand      @relation(fields: [brandId], references: [id])
  items MenuItem[]

  @@index([brandId])
  @@map("menu_categories")
}

model MenuItem {
  id          String   @id @default(uuid())
  brandId     String
  categoryId  String?
  name        String
  description String?
  price       Int // สตางค์
  costPrice   Int? // US-19: ต้นทุนวัตถุดิบต่อจาน (สตางค์) — null = ยังไม่กรอก
  imageUrl    String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand      Brand         @relation(fields: [brandId], references: [id])
  category   MenuCategory? @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@index([brandId, categoryId])
  @@map("menu_items")
}

// ─────────────────────────── Orders ───────────────────────────

enum OrderStatus {
  pending
  confirmed
  preparing
  ready // US-41: ครัวจัดเสร็จ รอไรเดอร์
  delivering
  completed
  cancelled
}

enum PaymentMethod {
  promptpay
  cod
}

enum PaymentStatus {
  unpaid
  pending
  paid
  expired
  refunded
}

model Order {
  id            String        @id @default(uuid())
  brandId       String
  kitchenId     String
  customerId    String
  addressId     String?
  status        OrderStatus   @default(pending)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(unpaid)

  // ยอดทั้งหมดหน่วยสตางค์ — คำนวณฝั่ง server เท่านั้น
  subtotal    Int
  deliveryFee Int @default(0)
  discount    Int @default(0)
  total       Int

  note           String?
  cancelReason   String?
  scheduledAt    DateTime? // US-22/US-28 pre-order
  idempotencyKey String    @unique // US-04: กันสร้างซ้ำ

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand    Brand       @relation(fields: [brandId], references: [id])
  kitchen  Kitchen     @relation(fields: [kitchenId], references: [id])
  customer Customer    @relation(fields: [customerId], references: [id])
  address  Address?    @relation(fields: [addressId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@index([brandId, status])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  menuItemId   String
  nameSnapshot String // เก็บชื่อ ณ ตอนสั่ง กันเมนูแก้ทีหลัง
  unitPrice    Int
  unitCost     Int? // US-19: snapshot ต้นทุน ณ ตอนสั่ง (แก้ต้นทุนทีหลังไม่กระทบรายงานเก่า)
  qty          Int
  lineTotal    Int
  note         String?

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// US-06: payment webhook ต้อง idempotent (unique providerRef)
model Payment {
  id          String        @id @default(uuid())
  orderId     String
  brandId     String
  method      PaymentMethod
  status      PaymentStatus @default(pending)
  amount      Int
  providerRef String?       @unique
  qrPayload   String?
  expiresAt   DateTime?
  paidAt      DateTime?
  raw         Json?
  createdAt   DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id])
  brand Brand @relation(fields: [brandId], references: [id])

  @@index([brandId])
  @@map("payments")
}

// ─────────────────────────── Messaging (US-09) ───────────────────────────

enum MessageType {
  flex_confirm
  status_push
  welcome
  broadcast
  auto_reply
  chat
}

// ช่องทางส่งจริง — reply ฟรี (ไม่นับโควตา), push นับโควตา
enum MessageChannel {
  reply
  push
}

enum MessageStatus {
  queued
  sent
  failed
}

// กันส่งซ้ำด้วย dedupeKey (เช่น orderId+status) + คุมโควตา LINE
model MessageLog {
  id                String        @id @default(uuid())
  brandId           String
  customerId        String?
  orderId           String?
  type              MessageType
  channel           MessageChannel? // reply/push — ใช้จริงตอนส่งออก (ดูสัดส่วนประหยัดโควตา)
  dedupeKey         String        @unique
  status            MessageStatus @default(queued)
  providerMessageId String?
  error             String?
  createdAt         DateTime      @default(now())

  brand Brand @relation(fields: [brandId], references: [id])

  @@index([brandId])
  @@map("message_logs")
}

// US-18 LINE broadcast: แคมเปญส่งข่าวสารถึงลูกค้าหลายคน (เคารพ opt-out PDPA + คุมโควตา)
enum BroadcastStatus {
  draft
  queued
  sending
  sent
  failed
}

model Broadcast {
  id            String          @id @default(uuid())
  brandId       String
  message       String // ข้อความ (snapshot ณ เวลาส่ง — มาจาก content หรือพิมพ์สด)
  segment       Json? // เกณฑ์ ad-hoc { tags?: string[] } — null = ทั้งหมด (ที่ไม่ opt-out)
  contentId     String? // อ้างคลังข้อความ (ถ้าเลือกจากคลัง)
  audienceId    String? // อ้างกลุ่มเป้าหมายที่บันทึกไว้ (ถ้าเลือก) — snapshot rules ตอนส่ง
  status        BroadcastStatus @default(draft)
  audienceCount Int             @default(0) // ผู้รับที่ resolve ได้ (หลังหัก opt-out)
  sentCount     Int             @default(0)
  failedCount   Int             @default(0)
  createdBy     String? // adminId ผู้สั่งส่ง
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  brand    Brand           @relation(fields: [brandId], references: [id])
  content  ContentLibrary? @relation(fields: [contentId], references: [id])
  audience Audience?       @relation(fields: [audienceId], references: [id])

  @@index([brandId, createdAt])
  @@map("broadcasts")
}

// US-18: คลังข้อความใช้ซ้ำ — เขียนเก็บไว้ก่อน แล้วดึงมาใช้ตอนส่ง broadcast
model ContentLibrary {
  id        String   @id @default(uuid())
  brandId   String
  title     String
  body      String
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand      Brand       @relation(fields: [brandId], references: [id])
  broadcasts Broadcast[]

  @@index([brandId, createdAt])
  @@map("content_library")
}

// US-18: กลุ่มเป้าหมายที่บันทึกไว้ล่วงหน้า — rules ประเมินสด (dynamic) ตอน preview/ส่ง
model Audience {
  id          String   @id @default(uuid())
  brandId     String
  name        String
  description String?
  rules       Json // { match: 'all'|'any', criteria: [...] } — ดู audiences/rules.ts
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand      Brand       @relation(fields: [brandId], references: [id])
  broadcasts Broadcast[]
  richMenus  RichMenu[]

  @@index([brandId, createdAt])
  @@map("audiences")
}

// Rich Menu ตามกลุ่ม (audience) — audienceId=null คือ default menu ของแบรนด์ (มีได้ 1 อัน บังคับในโค้ด)
model RichMenu {
  id             String   @id @default(uuid())
  brandId        String
  name           String
  /// null = default menu (คนใหม่/ไม่เข้ากลุ่มไหน) · มีค่า = ผูกกับกลุ่ม audience นี้
  audienceId     String?
  /// เลขน้อย = สำคัญกว่า (เช็คก่อนเวลาลูกค้าเข้าหลายกลุ่ม)
  priority       Int      @default(100)
  /// layout ปุ่ม (RichMenuZone[]) — ดู line/richmenu.ts
  zones          Json
  chatBarText    String   @default("เมนู")
  /// รูปที่ generate แล้ว (basename ใน media store) — ไว้ preview/re-upload
  imagePath      String?
  /// id ที่ LINE ออกให้ (null = ยังไม่ publish เช่น dev ไม่มี token)
  lineRichMenuId String?
  enabled        Boolean  @default(true)
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  brand    Brand     @relation(fields: [brandId], references: [id])
  // Restrict: ลบ audience ที่มี rich menu ผูกอยู่ไม่ได้ (กัน SET NULL ที่ทำให้เมนูกลุ่มกลายเป็น default เงียบ ๆ)
  audience Audience? @relation(fields: [audienceId], references: [id], onDelete: Restrict)

  @@index([brandId])
  @@index([brandId, audienceId])
  @@map("rich_menus")
}

// ─────────────────────────── Admin / audit ───────────────────────────

enum AdminRole {
  owner
  manager
  staff
  kitchen // US-45: เห็นเฉพาะจอครัว (KDS) + ไล่สถานะออเดอร์
  chat_agent // US-45: เห็นเฉพาะแชต
}

model AdminUser {
  id           String    @id @default(uuid())
  merchantId   String
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(staff)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  merchant    Merchant     @relation(fields: [merchantId], references: [id])
  adminBrands AdminBrand[]

  @@index([merchantId])
  @@map("admin_users")
}

// สิทธิ์ staff ต่อแบรนด์ (เห็นเฉพาะแบรนด์ที่ดูแล)
model AdminBrand {
  adminUserId String
  brandId     String

  adminUser AdminUser @relation(fields: [adminUserId], references: [id])
  brand     Brand     @relation(fields: [brandId], references: [id])

  @@id([adminUserId, brandId])
  @@index([brandId])
  @@map("admin_brands")
}

// US-12: ยกเลิก/เปลี่ยนสถานะต้องมี audit log
model AuditLog {
  id         String   @id @default(uuid())
  brandId    String
  actorType  String // admin | system | customer
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id])

  @@index([brandId, entityType, entityId])
  @@map("audit_logs")
}

// ── EP-14 Loyalty (US-50) ──
// แหล่งความจริงของแต้ม = LoyaltyTransaction (append-only) · customers.pointsBalance เป็น cache
// แต้มแยกต่อแบรนด์ (ADR-07) — ทุกตารางมี brandId

enum LoyaltyBatchStatus {
  draft // พิมพ์อยู่/ยังไม่ถึงร้าน — สแกนแล้วไม่ได้แต้ม (กันสแกนตั้งแต่โรงพิมพ์)
  active
  revoked
}

enum LoyaltyCodeStatus {
  active
  used
  revoked
}

enum LoyaltyRewardType {
  free_item
  discount
}

enum LoyaltyRedemptionStatus {
  pending // ออกคูปองแล้ว ยังไม่ตัดแต้ม
  confirmed // คนขายยืนยัน = ตัดแต้มตรงนี้ที่เดียว
  expired
  cancelled
}

enum LoyaltyTxType {
  earn
  redeem
  adjust // แอดมินแก้มือ (US-55)
  expire // แต้มหมดอายุ (เฟส 2)
}

/// ล็อตสติกเกอร์ QR ที่สั่งพิมพ์ครั้งหนึ่ง
model LoyaltyQrBatch {
  id          String             @id @default(uuid())
  brandId     String
  name        String
  menuItemId  String? // ผูกสินค้า (ไม่บังคับ — แต้มทั่วไปก็ได้)
  points      Int
  quantity    Int
  status      LoyaltyBatchStatus @default(draft)
  expiresAt   DateTime?
  createdById String? // admin ที่สร้าง
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  brand Brand           @relation(fields: [brandId], references: [id])
  codes LoyaltyQrCode[]

  @@index([brandId, status])
  @@map("loyalty_qr_batches")
}

/// QR 1 ใบ — ใช้ได้ครั้งเดียว (active → used ด้วย conditional update กันสแกนพร้อมกัน 2 คน)
model LoyaltyQrCode {
  id               String            @id @default(uuid())
  brandId          String
  batchId          String
  code             String            @unique
  points           Int // snapshot จาก batch — แก้ batch ทีหลังไม่กระทบใบที่พิมพ์แล้ว
  status           LoyaltyCodeStatus @default(active)
  usedByCustomerId String?
  usedAt           DateTime?
  createdAt        DateTime          @default(now())

  brand    Brand          @relation(fields: [brandId], references: [id])
  batch    LoyaltyQrBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  usedBy   Customer?      @relation(fields: [usedByCustomerId], references: [id])

  @@index([batchId, status])
  @@index([brandId, usedByCustomerId])
  @@map("loyalty_qr_codes")
}

model LoyaltyReward {
  id             String            @id @default(uuid())
  brandId        String
  name           String
  description    String?
  pointsCost     Int
  type           LoyaltyRewardType @default(free_item)
  menuItemId     String? // free_item
  discountAmount Int? // discount (สตางค์)
  isActive       Boolean           @default(true)
  sortOrder      Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  brand       Brand               @relation(fields: [brandId], references: [id])
  redemptions LoyaltyRedemption[]

  @@index([brandId, isActive])
  @@map("loyalty_rewards")
}

/// คูปองแลกแต้ม — ตัดแต้มตอน confirmed เท่านั้น จึงไม่ต้องมี job คืนแต้มเมื่อหมดอายุ
model LoyaltyRedemption {
  id                 String                  @id @default(uuid())
  brandId            String
  customerId         String
  rewardId           String
  rewardName         String // snapshot
  pointsCost         Int // snapshot
  token              String                  @unique // เนื้อหาใน QR คูปอง
  status             LoyaltyRedemptionStatus @default(pending)
  expiresAt          DateTime
  confirmedByAdminId String?
  confirmedAt        DateTime?
  orderId            String? // เฟส 2 (US-57): ใช้เป็นส่วนลดออเดอร์
  createdAt          DateTime                @default(now())

  brand    Brand         @relation(fields: [brandId], references: [id])
  customer Customer      @relation(fields: [customerId], references: [id])
  reward   LoyaltyReward @relation(fields: [rewardId], references: [id])

  @@index([brandId, status])
  @@index([customerId, status])
  @@map("loyalty_redemptions")
}

/// ledger append-only — ห้าม update/delete
model LoyaltyTransaction {
  id         String        @id @default(uuid())
  brandId    String
  customerId String
  type       LoyaltyTxType
  points     Int // มีเครื่องหมาย: +earn / -redeem
  refType    String? // 'qr_code' | 'redemption' | 'order' | 'admin'
  refId      String?
  note       String?
  createdAt  DateTime      @default(now())

  brand    Brand    @relation(fields: [brandId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, createdAt])
  @@index([brandId, createdAt])
  @@map("loyalty_transactions")
}
