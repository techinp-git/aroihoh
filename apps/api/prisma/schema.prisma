// AroiHoh — Prisma schema
// โมเดล tenant: Merchant → Brand → Kitchen (ดู docs/adr/0005-tenant-schema.md)
// กติกาเหล็ก:
//   - business data ทุกตารางติด brandId (tenant key) · ตารางระดับเจ้าของติด merchantId
//   - เงินเป็น Int หน่วยสตางค์เสมอ (ห้าม float)
//   - เขตจัดส่ง/ค่าส่งผูกที่ Kitchen · เก็บทั้ง lat/lng+radius และ geometry (รองรับ ADR-02 ทั้งสองทาง)
// ขอบเขต schema นี้ = พอสำหรับ Sprint 1 MVP (EP-01 + US-07/08/09/11/12/14/15)
//   ยังไม่ใส่: coupon(US-17), broadcast(US-18), subscription/catering, loyalty — เพิ่มเป็น migration ทีหลัง

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ─────────────────────────── Tenant hierarchy ───────────────────────────

enum MerchantStatus {
  active
  suspended
}

model Merchant {
  id        String         @id @default(uuid())
  name      String
  slug      String         @unique
  status    MerchantStatus @default(active)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  brands     Brand[]
  kitchens   Kitchen[]
  adminUsers AdminUser[]

  @@map("merchants")
}

model Brand {
  id         String  @id @default(uuid())
  merchantId String
  name       String
  slug       String
  logoUrl    String?
  theme      Json?
  isActive   Boolean @default(true)
  codEnabled Boolean @default(true) // US-07: เปิด/ปิดรับเก็บเงินปลายทาง

  // LINE credentials (SETUP-1) — secret/token ต้องเข้ารหัสก่อนเก็บ (US-25 cross-tenant isolation)
  lineChannelId        String?
  lineChannelSecretEnc String?
  lineChannelTokenEnc  String?
  liffId               String?
  richMenuId           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant      Merchant       @relation(fields: [merchantId], references: [id])
  brandKitchens BrandKitchen[]
  categories    MenuCategory[]
  menuItems     MenuItem[]
  customers     Customer[]
  orders        Order[]
  payments      Payment[]
  messageLogs   MessageLog[]
  adminBrands   AdminBrand[]
  auditLogs     AuditLog[]
  chatMessages  ChatMessage[]
  broadcasts    Broadcast[]
  contents      ContentLibrary[]
  audiences     Audience[]

  @@unique([merchantId, slug])
  @@index([merchantId])
  @@map("brands")
}

enum ZoneType {
  radius
  polygon
}

model Kitchen {
  id            String                                  @id @default(uuid())
  merchantId    String
  name          String
  lat           Float
  lng           Float
  zoneType      ZoneType                                @default(radius)
  maxDistanceKm Float? // ใช้เมื่อ zoneType = radius (กลยุทธ์ Haversine)
  // ใช้เมื่อ zoneType = polygon (กลยุทธ์ PostGIS) — query ผ่าน raw SQL (ST_Contains)
  deliveryZone  Unsupported("geometry(Polygon, 4326)")?
  isOpen        Boolean                                 @default(true) // US-16: ปุ่มพักรับออเดอร์ฉุกเฉิน
  openTime      String? // US-16: เวลาเปิด "HH:MM" (null = เปิดตลอด)
  closeTime     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant      Merchant          @relation(fields: [merchantId], references: [id])
  brandKitchens BrandKitchen[]
  feeRules      DeliveryFeeRule[]
  orders        Order[]

  @@index([merchantId])
  @@map("kitchens")
}

// ครัวเดียวแชร์หลายแบรนด์ได้ (คอนเซปต์ "หลายแบรนด์ ครัวเดียว")
model BrandKitchen {
  brandId   String
  kitchenId String

  brand   Brand   @relation(fields: [brandId], references: [id])
  kitchen Kitchen @relation(fields: [kitchenId], references: [id])

  @@id([brandId, kitchenId])
  @@index([kitchenId])
  @@map("brand_kitchens")
}

enum FeeRuleType {
  flat
  tiered
  per_km
}

// US-15: กฎค่าส่ง flat/tiered/per_km — พารามิเตอร์เก็บใน params (เช่น tiers, perKm, baseFee)
model DeliveryFeeRule {
  id        String      @id @default(uuid())
  kitchenId String
  type      FeeRuleType
  params    Json
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  kitchen Kitchen @relation(fields: [kitchenId], references: [id])

  @@index([kitchenId])
  @@map("delivery_fee_rules")
}

// ─────────────────────────── Customers (PII — PDPA) ───────────────────────────

model Customer {
  id          String   @id @default(uuid())
  brandId     String
  lineUserId  String
  displayName String?
  pictureUrl  String?
  phoneEnc    String? // เข้ารหัส — ห้าม log
  tags        String[] @default([]) // US-21: แท็กลูกค้า (VIP, ประจำ, ฯลฯ)
  marketingOptedOut Boolean @default(false) // PDPA: opt-out รับข่าวสาร/broadcast — ต้องเคารพเสมอ
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand        Brand         @relation(fields: [brandId], references: [id])
  addresses    Address[]
  orders       Order[]
  chatMessages ChatMessage[]

  @@unique([brandId, lineUserId])
  @@index([brandId])
  @@map("customers")
}

// US-21 Chat Center: แชตแอดมิน↔ลูกค้า (inbound มาจาก LINE webhook, outbound ยิงกลับผ่าน LINE)
enum ChatDirection {
  inbound
  outbound
}

model ChatMessage {
  id         String        @id @default(uuid())
  brandId    String
  customerId String
  direction  ChatDirection
  text       String
  adminId    String? // ผู้ส่ง (เฉพาะ outbound)
  isRead     Boolean       @default(false) // inbound ที่แอดมินยังไม่อ่าน
  createdAt  DateTime      @default(now())

  brand    Brand    @relation(fields: [brandId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([brandId, customerId, createdAt])
  @@map("chat_messages")
}

model Address {
  id         String   @id @default(uuid())
  customerId String
  label      String?
  detail     String
  lat        Float
  lng        Float
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  orders   Order[]

  @@index([customerId])
  @@map("addresses")
}

// ─────────────────────────── Menu (US-14) ───────────────────────────

model MenuCategory {
  id        String  @id @default(uuid())
  brandId   String
  name      String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  brand Brand      @relation(fields: [brandId], references: [id])
  items MenuItem[]

  @@index([brandId])
  @@map("menu_categories")
}

model MenuItem {
  id          String   @id @default(uuid())
  brandId     String
  categoryId  String?
  name        String
  description String?
  price       Int // สตางค์
  imageUrl    String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand      Brand         @relation(fields: [brandId], references: [id])
  category   MenuCategory? @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@index([brandId, categoryId])
  @@map("menu_items")
}

// ─────────────────────────── Orders ───────────────────────────

enum OrderStatus {
  pending
  confirmed
  preparing
  ready // US-41: ครัวจัดเสร็จ รอไรเดอร์
  delivering
  completed
  cancelled
}

enum PaymentMethod {
  promptpay
  cod
}

enum PaymentStatus {
  unpaid
  pending
  paid
  expired
  refunded
}

model Order {
  id            String        @id @default(uuid())
  brandId       String
  kitchenId     String
  customerId    String
  addressId     String?
  status        OrderStatus   @default(pending)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(unpaid)

  // ยอดทั้งหมดหน่วยสตางค์ — คำนวณฝั่ง server เท่านั้น
  subtotal    Int
  deliveryFee Int @default(0)
  discount    Int @default(0)
  total       Int

  note           String?
  cancelReason   String?
  scheduledAt    DateTime? // US-22/US-28 pre-order
  idempotencyKey String    @unique // US-04: กันสร้างซ้ำ

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand    Brand       @relation(fields: [brandId], references: [id])
  kitchen  Kitchen     @relation(fields: [kitchenId], references: [id])
  customer Customer    @relation(fields: [customerId], references: [id])
  address  Address?    @relation(fields: [addressId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@index([brandId, status])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  menuItemId   String
  nameSnapshot String // เก็บชื่อ ณ ตอนสั่ง กันเมนูแก้ทีหลัง
  unitPrice    Int
  qty          Int
  lineTotal    Int
  note         String?

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// US-06: payment webhook ต้อง idempotent (unique providerRef)
model Payment {
  id          String        @id @default(uuid())
  orderId     String
  brandId     String
  method      PaymentMethod
  status      PaymentStatus @default(pending)
  amount      Int
  providerRef String?       @unique
  qrPayload   String?
  expiresAt   DateTime?
  paidAt      DateTime?
  raw         Json?
  createdAt   DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id])
  brand Brand @relation(fields: [brandId], references: [id])

  @@index([brandId])
  @@map("payments")
}

// ─────────────────────────── Messaging (US-09) ───────────────────────────

enum MessageType {
  flex_confirm
  status_push
  welcome
  broadcast
  auto_reply
  chat
}

// ช่องทางส่งจริง — reply ฟรี (ไม่นับโควตา), push นับโควตา
enum MessageChannel {
  reply
  push
}

enum MessageStatus {
  queued
  sent
  failed
}

// กันส่งซ้ำด้วย dedupeKey (เช่น orderId+status) + คุมโควตา LINE
model MessageLog {
  id                String        @id @default(uuid())
  brandId           String
  customerId        String?
  orderId           String?
  type              MessageType
  channel           MessageChannel? // reply/push — ใช้จริงตอนส่งออก (ดูสัดส่วนประหยัดโควตา)
  dedupeKey         String        @unique
  status            MessageStatus @default(queued)
  providerMessageId String?
  error             String?
  createdAt         DateTime      @default(now())

  brand Brand @relation(fields: [brandId], references: [id])

  @@index([brandId])
  @@map("message_logs")
}

// US-18 LINE broadcast: แคมเปญส่งข่าวสารถึงลูกค้าหลายคน (เคารพ opt-out PDPA + คุมโควตา)
enum BroadcastStatus {
  draft
  queued
  sending
  sent
  failed
}

model Broadcast {
  id            String          @id @default(uuid())
  brandId       String
  message       String // ข้อความ (snapshot ณ เวลาส่ง — มาจาก content หรือพิมพ์สด)
  segment       Json? // เกณฑ์ ad-hoc { tags?: string[] } — null = ทั้งหมด (ที่ไม่ opt-out)
  contentId     String? // อ้างคลังข้อความ (ถ้าเลือกจากคลัง)
  audienceId    String? // อ้างกลุ่มเป้าหมายที่บันทึกไว้ (ถ้าเลือก) — snapshot rules ตอนส่ง
  status        BroadcastStatus @default(draft)
  audienceCount Int             @default(0) // ผู้รับที่ resolve ได้ (หลังหัก opt-out)
  sentCount     Int             @default(0)
  failedCount   Int             @default(0)
  createdBy     String? // adminId ผู้สั่งส่ง
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  brand    Brand           @relation(fields: [brandId], references: [id])
  content  ContentLibrary? @relation(fields: [contentId], references: [id])
  audience Audience?       @relation(fields: [audienceId], references: [id])

  @@index([brandId, createdAt])
  @@map("broadcasts")
}

// US-18: คลังข้อความใช้ซ้ำ — เขียนเก็บไว้ก่อน แล้วดึงมาใช้ตอนส่ง broadcast
model ContentLibrary {
  id        String   @id @default(uuid())
  brandId   String
  title     String
  body      String
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand      Brand       @relation(fields: [brandId], references: [id])
  broadcasts Broadcast[]

  @@index([brandId, createdAt])
  @@map("content_library")
}

// US-18: กลุ่มเป้าหมายที่บันทึกไว้ล่วงหน้า — rules ประเมินสด (dynamic) ตอน preview/ส่ง
model Audience {
  id          String   @id @default(uuid())
  brandId     String
  name        String
  description String?
  rules       Json // { match: 'all'|'any', criteria: [...] } — ดู audiences/rules.ts
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand      Brand       @relation(fields: [brandId], references: [id])
  broadcasts Broadcast[]

  @@index([brandId, createdAt])
  @@map("audiences")
}

// ─────────────────────────── Admin / audit ───────────────────────────

enum AdminRole {
  owner
  manager
  staff
}

model AdminUser {
  id           String    @id @default(uuid())
  merchantId   String
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(staff)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  merchant    Merchant     @relation(fields: [merchantId], references: [id])
  adminBrands AdminBrand[]

  @@index([merchantId])
  @@map("admin_users")
}

// สิทธิ์ staff ต่อแบรนด์ (เห็นเฉพาะแบรนด์ที่ดูแล)
model AdminBrand {
  adminUserId String
  brandId     String

  adminUser AdminUser @relation(fields: [adminUserId], references: [id])
  brand     Brand     @relation(fields: [brandId], references: [id])

  @@id([adminUserId, brandId])
  @@index([brandId])
  @@map("admin_brands")
}

// US-12: ยกเลิก/เปลี่ยนสถานะต้องมี audit log
model AuditLog {
  id         String   @id @default(uuid())
  brandId    String
  actorType  String // admin | system | customer
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id])

  @@index([brandId, entityType, entityId])
  @@map("audit_logs")
}
