# AroiHoh — production env (Hetzner) — คัดลอกเป็น .env.prod บนเครื่อง server แล้วเติมค่าจริง
# ⚠️ .env.prod ห้าม commit (อยู่ใน .gitignore แล้ว)

# ===== Postgres (docker-compose.prod.yml อ่านไปตั้ง container) =====
POSTGRES_USER=aroihoh
POSTGRES_PASSWORD=__CHANGE_ME_strong_password__
POSTGRES_DB=aroihoh

# ===== Database (API ต่อผ่านชื่อ service 'postgres' ใน docker network) =====
DATABASE_URL=postgresql://aroihoh:__CHANGE_ME_strong_password__@postgres:5432/aroihoh?schema=public

# ===== API =====
PORT=3000
NODE_ENV=production
PUBLIC_API_URL=https://api.jivecode.click       # ใช้ประกอบ Webhook URL ในหน้าตั้งค่า LINE
CORS_ORIGINS=https://order.jivecode.click,https://admin.jivecode.click  # ล็อกเฉพาะ 2 origin นี้

# ⚠️ ต้องสุ่มใหม่ ยาว ๆ คนละค่า (อย่าใช้ค่า default) — เช่น `openssl rand -hex 32`
JWT_SECRET=__CHANGE_ME_random_64hex__
ADMIN_JWT_SECRET=__CHANGE_ME_different_random_64hex__
# SEC-1: เข้ารหัส LINE secret/token at-rest (AES-256-GCM) — ห้ามเปลี่ยนหลังมีข้อมูลแล้ว (ถอดไม่ออก)
ENCRYPTION_KEY=__CHANGE_ME_random_64hex__

# owner admin ที่ seed สร้างครั้งแรก — เปลี่ยนรหัสจาก owner1234 เดี๋ยวนี้
ADMIN_SEED_EMAIL=owner@jivecode.click
ADMIN_SEED_PASSWORD=__CHANGE_ME_8char_plus__

# ⚠️ ห้ามตั้ง ALLOW_DEV_LOGIN ใน prod (เว้นว่าง = ปิด) — ไม่งั้น bypass login ได้
# ALLOW_DEV_LOGIN=

# ===== LINE — เว้นว่างได้ ตั้งผ่านหน้า Settings ในแอปต่อแบรนด์แทน (เก็บใน DB) =====
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LIFF_ID=

# ===== Redis — ตอนทำ BullMQ (US-09) ค่อยเปิด service + ตั้งค่านี้ =====
# REDIS_URL=redis://redis:6379
