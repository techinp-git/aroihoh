# ===== Database =====
DATABASE_URL="postgresql://aroihoh:aroihoh@localhost:5432/aroihoh?schema=public"

# ===== Redis (cache / session / BullMQ) =====
REDIS_URL="redis://localhost:6379"

# ===== API =====
PORT=3000
PUBLIC_API_URL="http://localhost:3000"   # โดเมนสาธารณะของ API — ใช้ประกอบ Webhook URL ที่โชว์ในหน้าตั้งค่า LINE
JWT_SECRET="change-me"                 # customer JWT (LIFF)
ADMIN_JWT_SECRET="change-me-admin"     # admin JWT (US-29) — ต้องคนละค่ากับ JWT_SECRET
ENCRYPTION_KEY=""                      # SEC-1: เข้ารหัส LINE secret/token at-rest — prod ต้องตั้ง (openssl rand -hex 32)
ADMIN_SEED_EMAIL="owner@example.com"   # owner admin ที่ seed สร้าง
ADMIN_SEED_PASSWORD="change-me-8char"

# ===== LINE (จาก SETUP-1: LINE OA + Messaging API Channel + LIFF) =====
# Webhook URL ที่ตั้งใน LINE Developers = https://<host>/api/line/webhook/<brandId>
# ค่าพวกนี้เป็น fallback ระดับ env (dev/แบรนด์เดียว) — prod เก็บต่อแบรนด์ใน brands.lineChannel*Enc
LINE_CHANNEL_ID=""            # ใช้ verify LIFF ID token (US-01) — ต้องตรงกับ channel ที่ LIFF ผูก
LINE_CHANNEL_SECRET=""        # ใช้ verify x-line-signature ของ webhook (กติกาเหล็ก #3)
LINE_CHANNEL_ACCESS_TOKEN=""  # ใช้ push/reply (broadcast/chat/แจ้งเตือน) — ว่าง = ระบบ skip (ไม่ยิงจริง)
LIFF_ID=""

# ===== Frontend (Vite อ่านเฉพาะตัวแปรที่ขึ้นต้น VITE_) =====
VITE_API_BASE_URL="http://localhost:3000/api"
VITE_LIFF_ID=""
